# Copy to .env (which is gitignored) and fill in real values.
# Required only for scripts/push-nuget.ps1 — packing locally does not need this.

# nuget.org API key, scoped to "Push new packages and versions" for the CapNet package ID.
# Create at https://www.nuget.org/account/apikeys
NUGET_API_KEY=

# Optional override (defaults to https://api.nuget.org/v3/index.json)
# NUGET_SOURCE=https://api.nuget.org/v3/index.json
